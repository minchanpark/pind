{
  "expo": {
    "name": "Pind",
    "slug": "pind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "pind",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.pind.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.pind.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "235bac09-4711-4c96-b83e-3938a47a22eb"
      }
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pind uses your photos so you can attach a dish to a taste log.",
          "cameraPermission": "Pind uses your camera so you can photograph a dish for a taste log.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Pind uses your location only to center the map and find nearby food places."
        }
      ]
    ]
  }
}
