GOOGLE_PLACES_API_KEY=replace_with_server_restricted_key

# Public/Pind catalog reads never call Google. Explicit Google searches only.
GOOGLE_FALLBACK_ENABLED=true
# Atomic limits shared across Edge instances. Units are outbound requests, not USD.
# Includes search, resolve, detail and photo; 0 disables paid requests.
GOOGLE_USER_DAILY_REQUESTS=20
GOOGLE_TOTAL_DAILY_REQUESTS=1000

# Opt in only after verifying provider terms for Pind. Empty disables both.
# Legacy adapters only; public-first production routes do not call these providers.
LOCAL_PLACES_PROVIDERS=
# Example after approval: kakao,naver (Kakao first, Naver only if empty)
KAKAO_LOCAL_REST_API_KEY=
# NAVER API HUB credentials, not legacy Naver Search API credentials.
NAVER_LOCAL_CLIENT_ID=
NAVER_LOCAL_CLIENT_SECRET=
